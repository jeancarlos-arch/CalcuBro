#:kivy 2.3.0

<ScheduleScreen>:
    name: 'schedule'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: app.bg_color
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [20, 16]
                spacing: 12

                # Encabezado
                Label:
                    text: "[font=MaterialIcons][/font]  [b]Horario semanal[/b]"
                    markup: True
                    font_size: '24sp'
                    color: app.text_primary
                    halign: 'left'
                    valign: 'middle'
                    size_hint_y: None
                    height: '32dp'
                    text_size: self.size

                # Selector de Semanas
                BoxLayout:
                    size_hint_y: None
                    height: '36dp'
                    Button:
                        text: ""
                        font_name: 'MaterialIcons'
                        font_size: '22sp'
                        size_hint_x: None
                        width: '40dp'
                        background_normal: ''
                        background_color: (0, 0, 0, 0)
                        color: app.accent_blue
                        on_release: root.prev_week()

                    Label:
                        text: f"[b]{root.week_range_text}[/b]"
                        markup: True
                        font_size: '14sp'
                        color: app.text_primary
                        halign: 'center'
                        valign: 'middle'

                    Button:
                        text: ""
                        font_name: 'MaterialIcons'
                        font_size: '22sp'
                        size_hint_x: None
                        width: '40dp'
                        background_normal: ''
                        background_color: (0, 0, 0, 0)
                        color: app.accent_blue
                        on_release: root.next_week()

                # Chips de Días (Lunes a Viernes)
                BoxLayout:
                    size_hint_y: None
                    height: '52dp'
                    spacing: 6

                    Button:
                        text: root.d0_text
                        font_size: '12sp'
                        halign: 'center'
                        background_normal: ''
                        background_down: ''
                        background_color: (0, 0, 0, 0)
                        color: app.primary_text if root.current_day_idx == 0 else app.text_secondary
                        bold: True
                        canvas.before:
                            Color:
                                rgba: app.primary_color if root.current_day_idx == 0 else app.card_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12)]
                            Color:
                                rgba: app.card_border
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(12)]
                                width: dp(1)
                        on_release: root.select_day(0)

                    Button:
                        text: root.d1_text
                        font_size: '12sp'
                        halign: 'center'
                        background_normal: ''
                        background_down: ''
                        background_color: (0, 0, 0, 0)
                        color: app.primary_text if root.current_day_idx == 1 else app.text_secondary
                        bold: True
                        canvas.before:
                            Color:
                                rgba: app.primary_color if root.current_day_idx == 1 else app.card_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12)]
                            Color:
                                rgba: app.card_border
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(12)]
                                width: dp(1)
                        on_release: root.select_day(1)

                    Button:
                        text: root.d2_text
                        font_size: '12sp'
                        halign: 'center'
                        background_normal: ''
                        background_down: ''
                        background_color: (0, 0, 0, 0)
                        color: app.primary_text if root.current_day_idx == 2 else app.text_secondary
                        bold: True
                        canvas.before:
                            Color:
                                rgba: app.primary_color if root.current_day_idx == 2 else app.card_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12)]
                            Color:
                                rgba: app.card_border
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(12)]
                                width: dp(1)
                        on_release: root.select_day(2)

                    Button:
                        text: root.d3_text
                        font_size: '12sp'
                        halign: 'center'
                        background_normal: ''
                        background_down: ''
                        background_color: (0, 0, 0, 0)
                        color: app.primary_text if root.current_day_idx == 3 else app.text_secondary
                        bold: True
                        canvas.before:
                            Color:
                                rgba: app.primary_color if root.current_day_idx == 3 else app.card_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12)]
                            Color:
                                rgba: app.card_border
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(12)]
                                width: dp(1)
                        on_release: root.select_day(3)

                    Button:
                        text: root.d4_text
                        font_size: '12sp'
                        halign: 'center'
                        background_normal: ''
                        background_down: ''
                        background_color: (0, 0, 0, 0)
                        color: app.primary_text if root.current_day_idx == 4 else app.text_secondary
                        bold: True
                        canvas.before:
                            Color:
                                rgba: app.primary_color if root.current_day_idx == 4 else app.card_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12)]
                            Color:
                                rgba: app.card_border
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(12)]
                                width: dp(1)
                        on_release: root.select_day(4)

                # Contenedor de clases
                BoxLayout:
                    id: classes_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 8

                # Botón Agregar Clase
                GhostButton:
                    text: "[font=MaterialIcons][/font]  Agregar clase"
                    markup: True
                    on_release: root.open_class_modal(-1)

                # Botón Importar Foto con estilo redondeado y borde sutil
                Button:
                    size_hint_y: None
                    height: '56dp'
                    background_normal: ''
                    background_down: ''
                    background_color: (0, 0, 0, 0)
                    color: app.accent_blue
                    bold: True
                    text: f"[size=18sp][font=MaterialIcons][/font][/size]   Importar foto del horario\\n[size=11sp][color={app.text_secondary_hex}]Reconocimiento automático y revisión[/color][/size]"
                    markup: True
                    halign: 'center'
                    canvas.before:
                        Color:
                            rgba: app.btn_pressed if self.state == 'down' else app.card_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(14)]
                        Color:
                            rgba: app.accent_blue
                        Line:
                            rounded_rectangle: [self.x, self.y, self.width, self.height, dp(14)]
                            width: dp(1)
                    on_release: root.go_import()

                # Tarjeta Notificaciones de clase
                DarkCard:
                    BoxLayout:
                        size_hint_y: None
                        height: '32dp'
                        Label:
                            text: "[b]Recordatorios de clase[/b]"
                            markup: True
                            font_size: '14sp'
                            color: app.text_primary
                            halign: 'left'
                            text_size: self.size
                        RoundedSwitch:
                            active: root.class_reminder_active
                            size_hint: (None, None)
                            size: ('52dp', '28dp')
                            on_active: root.toggle_reminder()

                    Label:
                        text: "Te avisaremos 30 minutos antes de cada clase." if root.class_reminder_active else "Notificaciones de clase desactivadas."
                        font_size: '12sp'
                        color: app.text_secondary
                        halign: 'left'
                        valign: 'middle'
                        size_hint_y: None
                        height: '28dp'
                        text_size: self.width, None

        NavBar:
