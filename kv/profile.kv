#:kivy 2.3.0

<ProfileScreen>:
    name: 'profile'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: app.bg_color
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [20, 16]
                spacing: 12

                # Encabezado
                Label:
                    text: "[b]Perfil[/b]"
                    markup: True
                    font_size: '24sp'
                    color: app.text_primary
                    halign: 'left'
                    valign: 'middle'
                    size_hint_y: None
                    height: '32dp'
                    text_size: self.size

                # Tarjeta de Usuario
                DarkCard:
                    BoxLayout:
                        size_hint_y: None
                        height: '56dp'
                        spacing: 14

                        # Avatar Circular
                        Label:
                            text: root.avatar_initial
                            font_name: 'MaterialIcons' if root.avatar_is_icon else 'Roboto'
                            font_size: '26sp' if root.avatar_is_icon else '22sp'
                            bold: True
                            color: app.primary_text
                            size_hint: (None, None)
                            size: ('50dp', '50dp')
                            canvas.before:
                                Color:
                                    rgba: app.primary_color
                                Ellipse:
                                    pos: self.pos
                                    size: self.size

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: 2
                            Label:
                                text: f"[b]{root.user_name}[/b]"
                                markup: True
                                font_size: '16sp'
                                color: app.text_primary
                                halign: 'left'
                                valign: 'middle'
                                text_size: self.size
                            Label:
                                text: root.user_career_sem
                                color: app.text_secondary
                                font_size: '12sp'
                                halign: 'left'
                                valign: 'middle'
                                text_size: self.size

                # Enlaces de Navegación fieles al prototipo
                ProfileLinkCard:
                    icon_text: ""
                    link_title: "Editar datos de estudiante / Login"
                    on_release: root.navigate('login')

                ProfileLinkCard:
                    icon_text: ""
                    link_title: "Recordatorios"
                    on_release: root.navigate('remind')

                ProfileLinkCard:
                    icon_text: ""
                    link_title: "Progreso"
                    on_release: root.navigate('progress')

                ProfileLinkCard:
                    icon_text: ""
                    link_title: "Diario personal"
                    on_release: root.navigate('diary')

                ProfileLinkCard:
                    icon_text: ""
                    link_title: "Calculadora"
                    on_release: root.navigate('calc')

                # Sección Apariencia / Selector de Tema (Modo Claro / Modo Oscuro)
                DarkCard:
                    spacing: dp(10)
                    BoxLayout:
                        size_hint_y: None
                        height: '32dp'
                        Label:
                            text: "[font=MaterialIcons][/font]  [b]Apariencia / Tema[/b]"
                            markup: True
                            font_size: '14sp'
                            color: app.text_primary
                            halign: 'left'
                            text_size: self.size
                        RoundedSwitch:
                            active: root.is_dark_theme
                            on_active: root.toggle_theme_switch(self.active)

                    BoxLayout:
                        size_hint_y: None
                        height: '20dp'
                        Label:
                            text: "Tema actual: Modo Oscuro" if root.is_dark_theme else "Tema actual: Modo Claro"
                            font_size: '12sp'
                            color: app.text_secondary
                            halign: 'left'
                            text_size: self.size

                    BoxLayout:
                        size_hint_y: None
                        height: '38dp'
                        spacing: dp(10)

                        Button:
                            text: "[font=MaterialIcons][/font]  Modo Claro"
                            markup: True
                            font_size: '13sp'
                            bold: True
                            background_normal: ''
                            background_down: ''
                            background_color: (0, 0, 0, 0)
                            color: app.primary_text if not root.is_dark_theme else app.text_secondary
                            canvas.before:
                                Color:
                                    rgba: app.primary_color if not root.is_dark_theme else app.btn_pressed
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(10)]
                                Color:
                                    rgba: app.card_border
                                Line:
                                    rounded_rectangle: [self.x, self.y, self.width, self.height, dp(10)]
                                    width: dp(1)
                            on_release: root.set_theme_mode('light')

                        Button:
                            text: "[font=MaterialIcons][/font]  Modo Oscuro"
                            markup: True
                            font_size: '13sp'
                            bold: True
                            background_normal: ''
                            background_down: ''
                            background_color: (0, 0, 0, 0)
                            color: app.primary_text if root.is_dark_theme else app.text_secondary
                            canvas.before:
                                Color:
                                    rgba: app.primary_color if root.is_dark_theme else app.btn_pressed
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(10)]
                                Color:
                                    rgba: app.card_border
                                Line:
                                    rounded_rectangle: [self.x, self.y, self.width, self.height, dp(10)]
                                    width: dp(1)
                            on_release: root.set_theme_mode('dark')

                # Ajuste de Notificaciones
                DarkCard:
                    BoxLayout:
                        size_hint_y: None
                        height: '32dp'
                        Label:
                            text: "[b]Notificaciones del sistema[/b]"
                            markup: True
                            font_size: '14sp'
                            color: app.text_primary
                            halign: 'left'
                            text_size: self.size
                        RoundedSwitch:
                            active: root.notifications_enabled
                            on_active: root.toggle_notifications(self.active)

                    Label:
                        text: "Avisos automáticos de clases y tareas"
                        font_size: '12sp'
                        color: app.text_secondary
                        halign: 'left'
                        text_size: self.size

        NavBar:
