#:kivy 2.3.0
#:import dp kivy.metrics.dp

<ProfileScreen>:
    name: 'profile'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: (0.063, 0.094, 0.153, 1) # --bg
            Rectangle:
                pos: self.pos
                size: self.size

        # Encabezado superior
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            padding: [dp(16), dp(8)]
            spacing: dp(8)

            Button:
                text: "< Volver"
                size_hint_x: None
                width: dp(80)
                background_normal: ''
                background_color: 0, 0, 0, 0
                color: (0.545, 0.718, 1.0, 1)
                font_size: '14sp'
                on_release: root.navigate('home')

            Label:
                text: "[b]Mi Perfil[/b]"
                markup: True
                font_size: '18sp'
                color: (0.957, 0.965, 0.980, 1)
                halign: 'right'
                valign: 'middle'
                text_size: self.size

        ScrollView:
            do_scroll_x: False
            bar_width: dp(3)

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(20), dp(10), dp(20), dp(20)]
                spacing: dp(16)

                # Tarjeta de Identidad del Estudiante
                DarkCard:
                    spacing: dp(12)
                    padding: dp(20)

                    BoxLayout:
                        size_hint_y: None
                        height: dp(70)
                        spacing: dp(16)

                        # Círculo de Avatar (Muestra icono o la inicial del nombre)
                        BoxLayout:
                            size_hint: None, None
                            size: dp(60), dp(60)
                            canvas.before:
                                Color:
                                    rgba: (0.337, 0.537, 0.910, 1)
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(30)]
                            Label:
                                text: root.avatar_initial
                                font_name: 'MaterialIcons' if root.avatar_is_icon else 'Roboto'
                                font_size: '28sp' if root.avatar_is_icon else '22sp'
                                bold: not root.avatar_is_icon
                                color: (1, 1, 1, 1)
                                halign: 'center'
                                valign: 'middle'
                                text_size: self.size

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: dp(4)

                            Label:
                                text: f"[b]{root.user_name}[/b]"
                                markup: True
                                font_size: '18sp'
                                color: (0.957, 0.965, 0.980, 1)
                                halign: 'left'
                                valign: 'bottom'
                                text_size: self.size

                            Label:
                                text: root.user_career_sem
                                font_size: '12sp'
                                color: (0.627, 0.682, 0.753, 1)
                                halign: 'left'
                                valign: 'top'
                                text_size: self.size

                    PrimaryButton:
                        text: "Actualizar datos académicos"
                        on_release: root.navigate('login')

                # Sección de Preferencias
                Label:
                    text: "[b]Preferencias[/b]"
                    markup: True
                    font_size: '14sp'
                    color: (0.627, 0.682, 0.753, 1)
                    size_hint_y: None
                    height: dp(24)
                    halign: 'left'
                    text_size: self.size

                DarkCard:
                    spacing: dp(12)
                    
                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        Label:
                            text: "Notificaciones generales"
                            font_size: '14sp'
                            color: (0.957, 0.965, 0.980, 1)
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size
                        Switch:
                            active: root.notifications_enabled
                            size_hint_y: None
                            height: dp(30)
                            size_hint_x: None
                            width: dp(60)
                            on_active: root.toggle_notifications(self.active)

                # Enlace limpio "Acerca de CalcuBro" con icono corregido
                Button:
                    text: "    [font=MaterialIcons]\ue88f[/font]    Acerca de CalcuBro"
                    markup: True
                    halign: 'left'
                    valign: 'middle'
                    font_size: '14sp'
                    size_hint_y: None
                    height: dp(48)
                    background_normal: ''
                    background_color: (0.106, 0.149, 0.220, 1)
                    color: (0.957, 0.965, 0.980, 1)
                    text_size: self.width, self.height
                    on_release: app.show_toast("CalcuBro v1.0 - Asistente Académico")

        NavBar: