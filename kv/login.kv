#:kivy 2.3.0

<SemesterOption@SpinnerOption>:
    background_normal: ''
    background_down: ''
    background_color: (0.106, 0.149, 0.220, 1) if self.state == 'normal' else (0.173, 0.227, 0.322, 1)
    color: (0.957, 0.965, 0.980, 1)
    font_size: '14sp'
    height: '42dp'

<LoginScreen>:
    name: 'login'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: (0.063, 0.094, 0.153, 1) # --bg
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [24, 20]
                spacing: 14

                # Botón Volver
                Button:
                    text: "[font=MaterialIcons]\ue5cb[/font]  Volver"
                    markup: True
                    size_hint: (None, None)
                    size: ('90dp', '32dp')
                    background_normal: ''
                    background_color: (0, 0, 0, 0)
                    color: (0.545, 0.718, 1.0, 1)
                    font_size: '15sp'
                    bold: True
                    on_release: root.go_back()

                # Encabezado con ícono
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: '84dp'
                    spacing: 4
                    AnchorLayout:
                        anchor_x: 'center'
                        anchor_y: 'center'
                        size_hint_y: None
                        height: '50dp'
                        BoxLayout:
                            size_hint: (None, None)
                            size: ('48dp', '48dp')
                            canvas.before:
                                Color:
                                    rgba: (0.106, 0.149, 0.220, 1)
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [14]
                                Color:
                                    rgba: (0.337, 0.537, 0.910, 0.3)
                                Line:
                                    rounded_rectangle: [self.x, self.y, self.width, self.height, 14]
                                    width: 1
                            Label:
                                text: "\ue80c"
                                font_name: 'MaterialIcons'
                                font_size: '28sp'
                                color: (0.545, 0.718, 1.0, 1)
                                halign: 'center'
                                valign: 'middle'
                    Label:
                        text: "[b]Registro de Estudiante[/b]"
                        markup: True
                        font_size: '22sp'
                        color: (0.957, 0.965, 0.980, 1)
                        size_hint_y: None
                        height: '30dp'
                        halign: 'center'

                Label:
                    text: "Personaliza tu horario, materias y seguimiento de notas ingresando tus datos académicos:"
                    font_size: '13sp'
                    color: (0.627, 0.682, 0.753, 1)
                    halign: 'center'
                    valign: 'middle'
                    size_hint_y: None
                    height: '48dp'
                    text_size: (self.width, None)

                # Formulario en Tarjeta
                DarkCard:
                    spacing: 10
                    padding: [16, 16]

                    # Campo Nombre
                    Label:
                        text: "Nombre y Apellido *"
                        font_size: '13sp'
                        bold: True
                        color: (0.545, 0.718, 1.0, 1)
                        size_hint_y: None
                        height: '22dp'
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size

                    StyledTextInput:
                        id: input_name
                        hint_text: "Ej: Jomar Pérez"

                    # Campo Carrera
                    Label:
                        text: "Carrera Universitaria *"
                        font_size: '13sp'
                        bold: True
                        color: (0.545, 0.718, 1.0, 1)
                        size_hint_y: None
                        height: '22dp'
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size

                    StyledTextInput:
                        id: input_career
                        hint_text: "Ej: Ingeniería en Sistemas"

                    # Campo Semestre (Desplegable 1ro a 8vo)
                    Label:
                        text: "Semestre *"
                        font_size: '13sp'
                        bold: True
                        color: (0.545, 0.718, 1.0, 1)
                        size_hint_y: None
                        height: '22dp'
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size

                    Spinner:
                        id: input_semester
                        text: "Selecciona tu semestre"
                        values: ["1er semestre", "2do semestre", "3er semestre", "4to semestre", "5to semestre", "6to semestre", "7mo semestre", "8vo semestre"]
                        option_cls: 'SemesterOption'
                        size_hint_y: None
                        height: '46dp'
                        font_size: '14sp'
                        halign: 'left'
                        valign: 'middle'
                        padding: [14, 0]
                        text_size: (self.width - dp(28), None)
                        color: (0.627, 0.682, 0.753, 1) if self.text == "Selecciona tu semestre" else (0.957, 0.965, 0.980, 1)
                        background_normal: ''
                        background_down: ''
                        background_color: (0, 0, 0, 0)
                        canvas.before:
                            Color:
                                rgba: (0.063, 0.094, 0.153, 1)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12)]
                            Color:
                                rgba: (0.173, 0.227, 0.322, 0.8)
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(12)]
                                width: dp(1.2)

                Widget:
                    size_hint_y: None
                    height: '6dp'

                # Botón Guardar e Ingresar
                PrimaryButton:
                    text: "Guardar e Ingresar"
                    on_release: root.submit_login()

                # Botón Secundario Omitir
                Button:
                    text: "Omitir por ahora"
                    size_hint_y: None
                    height: '38dp'
                    background_normal: ''
                    background_color: (0, 0, 0, 0)
                    color: (0.627, 0.682, 0.753, 1)
                    font_size: '13sp'
                    on_release: root.skip_login()

                Widget:
                    size_hint_y: None
                    height: '20dp'
