#:kivy 2.3.0

<LoginScreen>:
    name: 'login'
    BoxLayout:
        orientation: 'vertical'
        padding: 24
        spacing: 16
        canvas.before:
            Color:
                rgba: (0.063, 0.094, 0.153, 1) # Fondo principal (--bg)
            Rectangle:
                pos: self.pos
                size: self.size

        # Botón Volver superior
        BoxLayout:
            size_hint_y: None
            height: '40dp'
            Button:
                text: "Volver"
                font_size: '14sp'
                color: (0.337, 0.537, 0.910, 1)
                background_color: 0, 0, 0, 0
                size_hint_x: None
                width: '60dp'
                on_release: root.navigate('home')
            Widget:

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: 20
                padding: [0, 10]

                # Icono y Títulos
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: '110dp'
                    spacing: 8
                    halign: 'center'

                    Label:
                        text: "\ue80c"
                        font_name: 'MaterialIcons'
                        font_size: '32sp'
                        color: (0.337, 0.537, 0.910, 1)
                        size_hint_y: None
                        height: '40dp'

                    Label:
                        text: "[b]Registro de Estudiante[/b]"
                        markup: True
                        font_size: '22sp'
                        color: (0.957, 0.965, 0.980, 1)
                        size_hint_y: None
                        height: '28dp'

                    Label:
                        text: "Personaliza tus datos académicos para el seguimiento:"
                        font_size: '13sp'
                        color: (0.627, 0.682, 0.753, 1)
                        size_hint_y: None
                        height: '24sp'

                # Formulario Limpio sin asteriscos y con Spinner
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: '270dp'
                    spacing: 14

                    # Nombre y Apellido
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: '70dp'
                        spacing: 4
                        Label:
                            text: "Nombre y Apellido"
                            font_size: '13sp'
                            color: (0.8, 0.84, 0.9, 1)
                            halign: 'left'
                            text_size: self.size
                        TextInput:
                            id: name_input
                            hint_text: "Ej. Jomar Pérez"
                            multiline: False
                            size_hint_y: None
                            height: '44dp'
                            padding: [12, 12, 12, 12]
                            background_normal: ''
                            background_active: ''
                            background_color: (0.12, 0.16, 0.24, 1)
                            foreground_color: (0.95, 0.95, 0.95, 1)
                            hint_text_color: (0.5, 0.55, 0.65, 1)

                    # Carrera Universitaria
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: '70dp'
                        spacing: 4
                        Label:
                            text: "Carrera Universitaria"
                            font_size: '13sp'
                            color: (0.8, 0.84, 0.9, 1)
                            halign: 'left'
                            text_size: self.size
                        TextInput:
                            id: career_input
                            hint_text: "Ej. Ingeniería en Sistemas"
                            multiline: False
                            size_hint_y: None
                            height: '44dp'
                            padding: [12, 12, 12, 12]
                            background_normal: ''
                            background_active: ''
                            background_color: (0.12, 0.16, 0.24, 1)
                            foreground_color: (0.95, 0.95, 0.95, 1)
                            hint_text_color: (0.5, 0.55, 0.65, 1)

                    # Semestre (Menú Desplegable)
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: '70dp'
                        spacing: 4
                        Label:
                            text: "Semestre"
                            font_size: '13sp'
                            color: (0.8, 0.84, 0.9, 1)
                            halign: 'left'
                            text_size: self.size
                        Spinner:
                            id: semester_spinner
                            text: "Selecciona tu semestre"
                            values: ['1.er semestre', '2.do semestre', '3.er semestre', '4.to semestre', '5.to semestre', '6.to semestre', '7.mo semestre']
                            size_hint_y: None
                            height: '44dp'
                            background_normal: ''
                            background_color: (0.12, 0.16, 0.24, 1)
                            color: (0.9, 0.93, 0.96, 1)

                # Botones de Acción
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: '100dp'
                    spacing: 12
                    padding: [0, 10, 0, 0]

                    Button:
                        text: "Guardar e Ingresar"
                        size_hint_y: None
                        height: '48dp'
                        background_normal: ''
                        background_color: (0.337, 0.537, 0.910, 1)
                        color: (1, 1, 1, 1)
                        bold: True
                        font_size: '15sp'
                        on_release: root.save_data()

                    Button:
                        text: "Omitir por ahora"
                        size_hint_y: None
                        height: '36dp'
                        background_color: 0, 0, 0, 0
                        color: (0.627, 0.682, 0.753, 1)
                        font_size: '13sp'
                        on_release: root.navigate('home')
