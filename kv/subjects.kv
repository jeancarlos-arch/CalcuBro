#:kivy 2.3.0

<SubjectsScreen>:
    name: 'subjects'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: app.bg_color
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [20, 16]
                spacing: 12

                # Encabezado
                Label:
                    text: "[font=MaterialIcons][/font]  [b]Mis materias[/b]"
                    markup: True
                    font_size: '24sp'
                    color: app.text_primary
                    halign: 'left'
                    valign: 'middle'
                    size_hint_y: None
                    height: '32dp'
                    text_size: self.size

                Label:
                    text: root.subtitle_text
                    font_size: '13sp'
                    color: app.text_secondary
                    halign: 'left'
                    valign: 'top'
                    size_hint_y: None
                    height: '20dp'
                    text_size: self.size

                # Lista dinámica de materias
                BoxLayout:
                    id: subjects_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 10

                # Botón Agregar Materia
                GhostButton:
                    text: "[font=MaterialIcons][/font]  Agregar materia"
                    markup: True
                    on_release: root.open_subject_modal(-1)

        NavBar:
