#:kivy 2.3.0

<RemindScreen>:
    name: 'remind'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: app.bg_color
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [20, 16]
                spacing: 12

                # Botón Volver
                Button:
                    text: "[font=MaterialIcons][/font]  Volver"
                    markup: True
                    size_hint: (None, None)
                    size: ('90dp', '32dp')
                    background_normal: ''
                    background_color: (0, 0, 0, 0)
                    color: app.accent_blue
                    font_size: '15sp'
                    bold: True
                    on_release: app.go_back()

                # Encabezado con ícono outline bell (\ue7f5)
                Label:
                    text: "[font=MaterialIcons][/font]  [b]Recordatorios[/b]"
                    markup: True
                    font_size: '24sp'
                    color: app.text_primary
                    halign: 'left'
                    valign: 'middle'
                    size_hint_y: None
                    height: '32dp'
                    text_size: self.size

                Label:
                    text: "Clases, deberes, lecciones y entregas"
                    font_size: '13sp'
                    color: app.text_secondary
                    halign: 'left'
                    valign: 'top'
                    size_hint_y: None
                    height: '20dp'
                    text_size: self.size

                # Contenedor de recordatorios
                BoxLayout:
                    id: reminders_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 8

                GhostButton:
                    text: "[font=MaterialIcons][/font]  Agregar recordatorio"
                    markup: True
                    on_release: root.open_new_reminder_modal()

                Label:
                    text: "Toca un elemento para configurar su recordatorio."
                    font_size: '12sp'
                    color: app.text_secondary
                    halign: 'left'
                    size_hint_y: None
                    height: '24dp'
                    text_size: self.size

        NavBar:
