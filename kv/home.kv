#:kivy 2.3.0

<HomeScreen>:
    name: 'home'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: app.bg_color
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [20, 16]
                spacing: 14

                # Encabezado: Saludo y Subtítulo de Estudiante
                Label:
                    text: f"[b]{root.greeting_text}[/b]"
                    markup: True
                    font_size: '24sp'
                    color: app.text_primary
                    halign: 'left'
                    valign: 'middle'
                    size_hint_y: None
                    height: '32dp'
                    text_size: self.size

                Label:
                    text: root.student_subtitle
                    font_size: '13sp'
                    color: app.accent_blue
                    bold: True
                    halign: 'left'
                    valign: 'top'
                    size_hint_y: None
                    height: '20dp'
                    text_size: self.size

                # Bloque Choclito (pose 6) + burbuja dinámica
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: '92dp'
                    spacing: 12

                    AnchorLayout:
                        anchor_x: 'center'
                        anchor_y: 'center'
                        size_hint: (None, 1)
                        width: '86dp'
                        Image:
                            source: 'img/choclito_6.png'
                            size_hint: (None, None)
                            size: ('84dp', '84dp')
                            allow_stretch: True
                            keep_ratio: True

                    BoxLayout:
                        orientation: 'vertical'
                        padding: [14, 10]
                        canvas.before:
                            Color:
                                rgba: app.card_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(14)]
                            Color:
                                rgba: app.card_border
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(14)]
                                width: dp(1)

                        Label:
                            text: root.choclito_bubble_text
                            font_size: '13sp'
                            color: app.text_primary
                            halign: 'left'
                            valign: 'middle'
                            text_size: (self.width, self.height)

                # Tarjeta 1: Clases de Hoy (Enlace a Horario)
                RelativeLayout:
                    size_hint_y: None
                    height: '118dp'
                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint: (1, 1)
                        padding: [16, 12]
                        spacing: 10
                        canvas.before:
                            Color:
                                rgba: app.primary_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(14)]

                        # Icono grande
                        Label:
                            text: "[font=MaterialIcons][/font]"
                            markup: True
                            font_size: '32sp'
                            color: app.primary_text
                            opacity: 0.7
                            size_hint: (None, 1)
                            width: '42dp'
                            halign: 'center'
                            valign: 'top'

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: 3

                            Label:
                                text: root.active_class_time
                                font_size: '11sp'
                                color: app.primary_text
                                bold: True
                                halign: 'left'
                                size_hint_y: None
                                height: '16dp'
                                text_size: self.size

                            Label:
                                text: f"[b]{root.active_class_name}[/b]"
                                markup: True
                                font_size: '17sp'
                                color: app.primary_text
                                halign: 'left'
                                size_hint_y: None
                                height: '24dp'
                                text_size: self.size

                            Label:
                                text: f"[font=MaterialIcons][/font]  {root.active_class_room}"
                                markup: True
                                font_size: '12sp'
                                color: app.primary_text
                                opacity: 0.9
                                halign: 'left'
                                size_hint_y: None
                                height: '18dp'
                                text_size: self.size

                            Label:
                                text: root.next_class_info
                                font_size: '11sp'
                                color: app.primary_text
                                opacity: 0.8
                                halign: 'left'
                                size_hint_y: None
                                height: '16dp'
                                text_size: self.size

                    Button:
                        background_color: (0, 0, 0, 0)
                        size_hint: (1, 1)
                        on_release: root.navigate('schedule')

                # Tarjeta 2: Pendientes de hoy (Enlace a Recordatorios)
                RelativeLayout:
                    size_hint_y: None
                    height: '100dp'
                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint: (1, 1)
                        padding: [16, 12]
                        spacing: 10
                        canvas.before:
                            Color:
                                rgba: app.card_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(14)]
                            Color:
                                rgba: app.card_border
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(14)]
                                width: dp(1)

                        # Icono de campana outline
                        Label:
                            text: "[font=MaterialIcons][/font]"
                            markup: True
                            font_size: '28sp'
                            color: app.orange_color
                            size_hint: (None, 1)
                            width: '36dp'
                            halign: 'center'
                            valign: 'top'

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: 4

                            BoxLayout:
                                size_hint_y: None
                                height: '22dp'
                                Label:
                                    text: "[b]Pendientes de hoy[/b]"
                                    markup: True
                                    font_size: '14sp'
                                    color: app.text_primary
                                    halign: 'left'
                                    text_size: self.size
                                Label:
                                    text: f"[color={app.orange_color_hex}][size=12sp]{root.reminders_count_text}[/size][/color]"
                                    markup: True
                                    halign: 'right'
                                    size_hint_x: None
                                    width: '100dp'
                                    text_size: self.size

                            Label:
                                text: root.reminders_summary_text
                                font_size: '12sp'
                                color: app.text_secondary
                                halign: 'left'
                                valign: 'top'
                                text_size: self.width, None

                    Button:
                        background_color: (0, 0, 0, 0)
                        size_hint: (1, 1)
                        on_release: root.navigate('remind')

                # Tarjeta 3: Progreso del semestre (Enlace a Progreso)
                RelativeLayout:
                    size_hint_y: None
                    height: '120dp'
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint: (1, 1)
                        padding: [16, 12]
                        spacing: 6
                        canvas.before:
                            Color:
                                rgba: app.card_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(14)]
                            Color:
                                rgba: app.card_border
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(14)]
                                width: dp(1)

                        BoxLayout:
                            size_hint_y: None
                            height: '24dp'
                            spacing: 6
                            Label:
                                text: "[font=MaterialIcons][/font]  [b]Progreso del semestre[/b]"
                                markup: True
                                font_size: '14sp'
                                color: app.text_primary
                                halign: 'left'
                                text_size: self.size
                            Label:
                                text: f"[color={app.green_color_hex}][b]{root.progress_percent}%[/b][/color]"
                                markup: True
                                halign: 'right'
                                size_hint_x: None
                                width: '60dp'
                                font_size: '17sp'
                                text_size: self.size

                        CustomProgressBar:
                            value: root.progress_percent
                            bar_color: app.green_color

                        Label:
                            text: root.motivational_text
                            font_size: '12sp'
                            color: app.text_secondary
                            halign: 'left'
                            valign: 'middle'
                            size_hint_y: None
                            height: '36dp'
                            text_size: self.width, None

                    Button:
                        background_color: (0, 0, 0, 0)
                        size_hint: (1, 1)
                        on_release: root.navigate('progress')

                # Título de Accesos Directos
                Label:
                    text: "[b]Funcionalidades principales[/b]"
                    markup: True
                    font_size: '15sp'
                    color: app.text_primary
                    halign: 'left'
                    size_hint_y: None
                    height: '22dp'
                    text_size: self.size

                # Grilla de 6 Accesos Directos fieles al Prototipo
                GridLayout:
                    cols: 3
                    size_hint_y: None
                    height: '176dp'
                    spacing: 8

                    TileButton:
                        icon_text: ""
                        title_text: "Materias"
                        on_release: root.navigate('subjects')

                    TileButton:
                        icon_text: ""
                        title_text: "Horario"
                        on_release: root.navigate('schedule')

                    TileButton:
                        icon_text: ""
                        title_text: "Calculadora"
                        on_release: root.navigate('calc')

                    TileButton:
                        icon_text: ""
                        title_text: "Diario"
                        on_release: root.navigate('diary')

                    TileButton:
                        icon_text: ""
                        title_text: "Progreso"
                        on_release: root.navigate('progress')

                    TileButton:
                        icon_text: ""
                        title_text: "Recordatorios"
                        on_release: root.navigate('remind')

                Widget:
                    size_hint_y: None
                    height: '10dp'

        NavBar: