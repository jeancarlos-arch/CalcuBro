#:kivy 2.3.0

<WelcomeScreen>:
    name: 'welcome'
    BoxLayout:
        orientation: 'vertical'
        padding: [24, 40]
        spacing: 20
        canvas.before:
            Color:
                rgba: app.bg_color
            Rectangle:
                pos: self.pos
                size: self.size

        Widget:
            size_hint_y: 0.15

        # Logotipo / Isotipo StudyMate
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: '110dp'
            AnchorLayout:
                anchor_x: 'center'
                anchor_y: 'center'
                BoxLayout:
                    size_hint: (None, None)
                    size: ('88dp', '88dp')
                    canvas.before:
                        Color:
                            rgba: app.card_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [24]
                        Color:
                            rgba: app.card_border
                        Line:
                            rounded_rectangle: [self.x, self.y, self.width, self.height, 24]
                            width: 1.5
                    Label:
                        text: ""
                        font_name: 'MaterialIcons'
                        font_size: '52sp'
                        color: app.accent_blue
                        halign: 'center'
                        valign: 'middle'

        # Título
        Label:
            text: "[b]StudyMate[/b]"
            markup: True
            font_size: '34sp'
            color: app.text_primary
            size_hint_y: None
            height: '46dp'
            halign: 'center'

        # Descripción
        Label:
            text: "Tu acompañante académico: horario, notas\ny motivación en un solo lugar."
            font_size: '15sp'
            color: app.text_secondary
            halign: 'center'
            valign: 'middle'
            size_hint_y: None
            height: '50dp'

        Widget:
            size_hint_y: 0.25

        # Botón Comenzar
        PrimaryButton:
            text: "Comenzar"
            on_release: root.go_home()

        # Botón Calculadora sin cuenta
        Button:
            text: "Solo usar la calculadora, sin cuenta"
            size_hint_y: None
            height: '44dp'
            background_normal: ''
            background_color: (0, 0, 0, 0)
            color: app.accent_blue
            font_size: '14sp'
            on_release: root.go_calc()

        Widget:
            size_hint_y: 0.1
