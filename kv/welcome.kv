#:kivy 2.3.0

<WelcomeScreen>:
    name: 'welcome'
    BoxLayout:
        orientation: 'vertical'
        padding: [24, 24]
        spacing: 10
        canvas.before:
            Color:
                rgba: app.bg_color
            Rectangle:
                pos: self.pos
                size: self.size

        Widget:
            size_hint_y: 0.04

        # Mascota Choclito arriba como protagonista (estilo Choclito.html)
        AnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'
            size_hint_y: None
            height: '250dp'
            Image:
                source: 'img/choclito_2.png'
                size_hint: (None, None)
                size: ('230dp', '230dp')
                allow_stretch: True
                keep_ratio: True

        # Título
        Label:
            text: "[b]CalcuBro[/b]"
            markup: True
            font_size: '34sp'
            color: app.text_primary
            size_hint_y: None
            height: '42dp'
            halign: 'center'
            valign: 'middle'
            text_size: self.size

        # Descripción (igual a Choclito.html)
        Label:
            text: "Soy Choclito, tu acompañante académico:\nhorario, notas y motivación en un solo lugar."
            font_size: '15sp'
            color: app.text_secondary
            halign: 'center'
            valign: 'middle'
            size_hint_y: None
            height: '42dp'
            text_size: self.size

        # Botón Comenzar
        PrimaryButton:
            text: "Comenzar"
            on_release: root.go_home()

        # Botón Calculadora sin cuenta
        Button:
            text: "Solo usar la calculadora, sin cuenta"
            size_hint_y: None
            height: '40dp'
            background_normal: ''
            background_color: (0, 0, 0, 0)
            color: app.accent_blue
            font_size: '14sp'
            on_release: root.go_calc()

        Widget:
            size_hint_y: 0.04