#:kivy 2.3.0
#:import dp kivy.metrics.dp

<CalcScreen>:
    name: 'calc'

    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: (0.063, 0.094, 0.153, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            bar_width: dp(3)

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(20), dp(18), dp(20), dp(18)]
                spacing: dp(12)

                # Encabezado
                BoxLayout:
                    size_hint_y: None
                    height: dp(38)
                    spacing: dp(8)

                    Button:
                        text: "[font=MaterialIcons]\\ue5cb[/font]  Volver"
                        markup: True
                        size_hint_x: None
                        width: dp(85)
                        background_normal: ''
                        background_color: (0, 0, 0, 0)
                        color: (0.545, 0.718, 1.0, 1)
                        font_size: '14sp'
                        on_release: app.go_back()

                    Label:
                        text: "Calculadora académica"
                        color: (0.957, 0.965, 0.980, 1)
                        font_size: '19sp'
                        bold: True
                        halign: 'right'
                        valign: 'middle'
                        text_size: self.size

                Label:
                    text: "Calcula tu promedio, revisa cuánto necesitas y simula tu nota final."
                    color: (0.627, 0.682, 0.753, 1)
                    font_size: '12sp'
                    size_hint_y: None
                    height: dp(34)
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.width, None

                # Escala académica
                DarkCard:
                    Label:
                        text: "Escala académica"
                        color: (0.545, 0.718, 1.0, 1)
                        font_size: '14sp'
                        bold: True
                        size_hint_y: None
                        height: dp(22)
                        halign: 'left'
                        text_size: self.size

                    GridLayout:
                        cols: 3
                        spacing: dp(8)
                        size_hint_y: None
                        height: dp(64)

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: dp(4)
                            Label:
                                text: "Nota máxima"
                                color: (0.627, 0.682, 0.753, 1)
                                font_size: '11sp'
                                size_hint_y: None
                                height: dp(18)
                            StyledTextInput:
                                id: scale_max_input
                                text: "10"
                                input_filter: 'float'
                                on_text: root.set_scale_value('max', self.text)

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: dp(4)
                            Label:
                                text: "Mínima"
                                color: (0.627, 0.682, 0.753, 1)
                                font_size: '11sp'
                                size_hint_y: None
                                height: dp(18)
                            StyledTextInput:
                                id: scale_min_input
                                text: "7"
                                input_filter: 'float'
                                on_text: root.set_scale_value('min', self.text)

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: dp(4)
                            Label:
                                text: "Objetivo"
                                color: (0.627, 0.682, 0.753, 1)
                                font_size: '11sp'
                                size_hint_y: None
                                height: dp(18)
                            StyledTextInput:
                                id: scale_goal_input
                                text: "8.5"
                                input_filter: 'float'
                                on_text: root.set_scale_value('goal', self.text)

                # Notas
                DarkCard:
                    Label:
                        text: "Mis notas"
                        color: (0.545, 0.718, 1.0, 1)
                        font_size: '14sp'
                        bold: True
                        size_hint_y: None
                        height: dp(22)
                        halign: 'left'
                        text_size: self.size

                    PrimaryButton:
                        text: "+ Agregar nota"
                        size_hint_y: None
                        height: dp(42)
                        on_release: root.add_grade()

                    BoxLayout:
                        id: grades_container
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(8)

                # Simulación
                DarkCard:
                    Label:
                        text: "Simular nota en lo pendiente"
                        color: (0.545, 0.718, 1.0, 1)
                        font_size: '14sp'
                        bold: True
                        size_hint_y: None
                        height: dp(22)
                        halign: 'left'
                        text_size: self.size

                    Label:
                        text: "Escribe una nota para calcular cuánto tendrías al final."
                        color: (0.627, 0.682, 0.753, 1)
                        font_size: '12sp'
                        size_hint_y: None
                        height: dp(30)
                        halign: 'left'
                        text_size: self.width, None

                    StyledTextInput:
                        hint_text: "Ejemplo: 9"
                        text: root.sim_grade_text
                        input_filter: 'float'
                        on_text: root.sim_grade_text = self.text; root.calculate_results(silent=True)

                    Label:
                        text: root.sim_result_text
                        color: (0.545, 0.718, 1.0, 1)
                        font_size: '12sp'
                        size_hint_y: None
                        height: dp(38) if root.sim_result_text else 0
                        opacity: 1 if root.sim_result_text else 0
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.width, None

                # Resultados
                DarkCard:
                    Label:
                        text: root.warning_text
                        color: (0.949, 0.651, 0.353, 1)
                        font_size: '12sp'
                        size_hint_y: None
                        height: dp(30) if root.warning_text else 0
                        opacity: 1 if root.warning_text else 0
                        halign: 'left'
                        text_size: self.width, None

                    BoxLayout:
                        size_hint_y: None
                        height: dp(24)
                        Label:
                            text: "Evaluado: " + root.evaluated_text
                            color: (0.627, 0.682, 0.753, 1)
                            font_size: '12sp'
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: "Pendiente: " + root.pending_text
                            color: (0.627, 0.682, 0.753, 1)
                            font_size: '12sp'
                            halign: 'right'
                            text_size: self.size

                    CustomProgressBar:
                        value: root.progress_percent

                    BoxLayout:
                        size_hint_y: None
                        height: dp(34)
                        Label:
                            text: "Promedio ponderado actual"
                            color: (0.627, 0.682, 0.753, 1)
                            font_size: '12sp'
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: root.current_avg_text
                            color: (0.545, 0.718, 1.0, 1)
                            font_size: '21sp'
                            bold: True
                            halign: 'right'
                            text_size: self.size

                    Label:
                        text: "Puntos acumulados: " + root.accum_pts_text
                        color: (0.627, 0.682, 0.753, 1)
                        font_size: '12sp'
                        size_hint_y: None
                        height: dp(20)
                        halign: 'left'
                        text_size: self.size

                    Label:
                        text: "Máxima nota final posible: " + root.max_possible_text
                        color: (0.957, 0.965, 0.980, 1)
                        font_size: '13sp'
                        size_hint_y: None
                        height: dp(22)
                        halign: 'left'
                        text_size: self.size

                    Label:
                        text: root.min_status_text
                        color: (0.224, 0.788, 0.541, 1)
                        font_size: '12sp'
                        size_hint_y: None
                        height: dp(34)
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.width, None

                    Label:
                        text: root.goal_status_text
                        color: (0.545, 0.718, 1.0, 1)
                        font_size: '12sp'
                        size_hint_y: None
                        height: dp(34)
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.width, None

                PrimaryButton:
                    text: "Calcular resultados"
                    on_release: root.calculate_results(silent=False)

                GhostButton:
                    text: "[font=MaterialIcons]\\ue863[/font]  Restablecer ejemplo"
                    markup: True
                    on_release: root.reset_example()

        NavBar:
