#:kivy 2.3.0

<CalcKeyButton@Button>:
    background_normal: ''
    background_down: ''
    background_color: (0, 0, 0, 0)
    color: app.text_primary
    font_size: '20sp'
    bold: True
    canvas.before:
        Color:
            rgba: app.btn_pressed if self.state == 'down' else app.card_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        Color:
            rgba: app.card_border
        Line:
            rounded_rectangle: [self.x, self.y, self.width, self.height, dp(14)]
            width: dp(1)

<CalcOpButton@Button>:
    background_normal: ''
    background_down: ''
    background_color: (0, 0, 0, 0)
    color: app.accent_blue
    font_size: '20sp'
    bold: True
    canvas.before:
        Color:
            rgba: app.btn_pressed if self.state == 'down' else app.input_bg
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        Color:
            rgba: app.card_border
        Line:
            rounded_rectangle: [self.x, self.y, self.width, self.height, dp(14)]
            width: dp(1)

<CalcActionButton@Button>:
    background_normal: ''
    background_down: ''
    background_color: (0, 0, 0, 0)
    color: app.primary_text
    font_size: '20sp'
    bold: True
    canvas.before:
        Color:
            rgba: app.primary_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]

<CalcEqualButton@Button>:
    background_normal: ''
    background_down: ''
    background_color: (0, 0, 0, 0)
    color: (1, 1, 1, 1)
    font_size: '20sp'
    bold: True
    canvas.before:
        Color:
            rgba: app.green_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]


<CalcScreen>:
    name: 'calc'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: app.bg_color
            Rectangle:
                pos: self.pos
                size: self.size

        # Barra Superior y Selector de Modo
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: '106dp'
            padding: [20, 12, 20, 6]
            spacing: 8

            BoxLayout:
                size_hint_y: None
                height: '32dp'
                Button:
                    text: "[font=MaterialIcons]\ue5cb[/font]  Volver"
                    markup: True
                    size_hint: (None, None)
                    size: ('85dp', '32dp')
                    background_normal: ''
                    background_color: (0, 0, 0, 0)
                    color: app.accent_blue
                    font_size: '15sp'
                    bold: True
                    on_release: app.go_back()

                Label:
                    text: "[font=MaterialIcons]\uea5f[/font]  [b]Calculadora[/b]"
                    markup: True
                    font_size: '20sp'
                    color: app.text_primary
                    halign: 'center'
                    valign: 'middle'

                Widget:
                    size_hint_x: None
                    width: '85dp'

            # Selector de Modo (Ponderada vs Básica)
            BoxLayout:
                size_hint_y: None
                height: '42dp'
                spacing: 6
                padding: [2, 2]
                canvas.before:
                    Color:
                        rgba: app.input_bg
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(14)]
                    Color:
                        rgba: app.card_border
                    Line:
                        rounded_rectangle: [self.x, self.y, self.width, self.height, dp(14)]
                        width: dp(1)

                Button:
                    text: "[font=MaterialIcons]\ue26b[/font]  Ponderada"
                    markup: True
                    font_size: '13sp'
                    bold: True
                    background_normal: ''
                    background_down: ''
                    background_color: (0, 0, 0, 0)
                    color: app.primary_text if root.active_calc_mode == 'weighted' else app.text_secondary
                    canvas.before:
                        Color:
                            rgba: app.primary_color if root.active_calc_mode == 'weighted' else (0, 0, 0, 0)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]
                    on_release: root.set_mode('weighted')

                Button:
                    text: "[font=MaterialIcons]\uea5f[/font]  Básica"
                    markup: True
                    font_size: '13sp'
                    bold: True
                    background_normal: ''
                    background_down: ''
                    background_color: (0, 0, 0, 0)
                    color: app.primary_text if root.active_calc_mode == 'standard' else app.text_secondary
                    canvas.before:
                        Color:
                            rgba: app.primary_color if root.active_calc_mode == 'standard' else (0, 0, 0, 0)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]
                    on_release: root.set_mode('standard')

        # ===== VISTA 1: CALCULADORA ACADÉMICA PONDERADA =====
        ScrollView:
            do_scroll_x: False
            opacity: 1 if root.active_calc_mode == 'weighted' else 0
            size_hint_y: 1 if root.active_calc_mode == 'weighted' else None
            height: 0 if root.active_calc_mode != 'weighted' else self.height
            disabled: root.active_calc_mode != 'weighted'

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [20, 10]
                spacing: 12

                # 1. Escala Académica
                DarkCard:
                    Label:
                        text: "[font=MaterialIcons]\ue39e[/font]  Escala Académica"
                        markup: True
                        font_size: '13sp'
                        bold: True
                        color: app.accent_blue
                        size_hint_y: None
                        height: '20dp'
                        halign: 'left'
                        text_size: self.size

                    GridLayout:
                        cols: 3
                        size_hint_y: None
                        height: '62dp'
                        spacing: 8

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: 4
                            Label:
                                text: "Nota máx."
                                font_size: '11sp'
                                color: app.text_secondary
                                size_hint_y: None
                                height: '16dp'
                            StyledTextInput:
                                text: str(root.scale_max)
                                input_filter: 'float'
                                on_text: root.scale_max = float(self.text or 10.0); root.calculate_results(silent=True)

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: 4
                            Label:
                                text: "Mín. aprobar"
                                font_size: '11sp'
                                color: app.text_secondary
                                size_hint_y: None
                                height: '16dp'
                            StyledTextInput:
                                text: str(root.scale_min)
                                input_filter: 'float'
                                on_text: root.scale_min = float(self.text or 7.0); root.calculate_results(silent=True)

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: 4
                            Label:
                                text: "Meta personal"
                                font_size: '11sp'
                                color: app.text_secondary
                                size_hint_y: None
                                height: '16dp'
                            StyledTextInput:
                                text: str(root.scale_goal)
                                input_filter: 'float'
                                on_text: root.scale_goal = float(self.text or 8.5); root.calculate_results(silent=True)

                # 2. Lista dinámica de evaluaciones
                BoxLayout:
                    id: grades_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 8

                # 3. Botón Agregar nota
                GhostButton:
                    text: "[font=MaterialIcons]\ue145[/font]  Agregar nota"
                    markup: True
                    font_size: '14sp'
                    size_hint_y: None
                    height: '46dp'
                    on_release: root.add_grade()

                # 4. Simulador de nota en lo pendiente
                DarkCard:
                    Label:
                        text: "[font=MaterialIcons]\ue65f[/font]  Simular nota en lo pendiente"
                        markup: True
                        font_size: '13sp'
                        bold: True
                        color: app.accent_blue
                        size_hint_y: None
                        height: '20dp'
                        halign: 'left'
                        text_size: self.size

                    Label:
                        text: f"¿Cuánto sacarías si obtienes cierta nota en el {root.pending_text} restante?"
                        font_size: '12sp'
                        color: app.text_secondary
                        size_hint_y: None
                        height: '18dp'
                        halign: 'left'
                        text_size: self.size

                    StyledTextInput:
                        hint_text: "Ingresa nota tentativa (ej: 8.5)"
                        text: root.sim_grade_text
                        input_filter: 'float'
                        on_text: root.sim_grade_text = self.text; root.calculate_results(silent=True)

                    Label:
                        text: root.sim_result_text
                        color: app.accent_blue
                        font_size: '12sp'
                        size_hint_y: None
                        height: '36dp' if root.sim_result_text else '0dp'
                        opacity: 1 if root.sim_result_text else 0
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.width, None

                # 5. Resultados calculados automáticamente
                DarkCard:
                    Label:
                        text: f"[font=MaterialIcons]\ue002[/font]  [color={app.orange_color_hex}][b]{root.warning_text}[/b][/color]" if root.warning_text else ""
                        markup: True
                        size_hint_y: None
                        height: '24dp' if root.warning_text else '0dp'
                        opacity: 1 if root.warning_text else 0

                    BoxLayout:
                        size_hint_y: None
                        height: '22dp'
                        Label:
                            text: f"[font=MaterialIcons]\ue876[/font]  Evaluado: [b]{root.evaluated_text}[/b]"
                            markup: True
                            color: app.text_secondary
                            font_size: '12sp'
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: f"Pendiente: [b]{root.pending_text}[/b]"
                            markup: True
                            color: app.text_secondary
                            font_size: '12sp'
                            halign: 'right'
                            text_size: self.size

                    CustomProgressBar:
                        value: root.progress_percent
                        bar_color: app.green_color

                    BoxLayout:
                        size_hint_y: None
                        height: '42dp'
                        Label:
                            text: "[font=MaterialIcons]\ue6e1[/font]  Promedio ponderado"
                            markup: True
                            color: app.text_secondary
                            font_size: '13sp'
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: f"[color={app.accent_blue_hex}][b]{root.current_avg_text}[/b][/color]"
                            markup: True
                            font_size: '26sp'
                            halign: 'right'
                            size_hint_x: None
                            width: '90dp'
                            text_size: self.size

                    Label:
                        text: f"[font=MaterialIcons]\ue8e5[/font]  Puntos: [b]{root.accum_pts_text}[/b]      Máx posible: [b]{root.max_possible_text}[/b]"
                        markup: True
                        color: app.text_secondary
                        font_size: '11sp'
                        size_hint_y: None
                        height: '20dp'
                        halign: 'left'
                        text_size: self.width, None

                    Label:
                        text: f"[font=MaterialIcons]\ue5ca[/font]  [color={app.green_color_hex}]{root.min_status_text}[/color]"
                        markup: True
                        font_size: '12sp'
                        size_hint_y: None
                        height: '24dp'
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.width, None

                    Label:
                        text: f"[font=MaterialIcons]\ue838[/font]  [color={app.primary_color_hex}]{root.goal_status_text}[/color]"
                        markup: True
                        font_size: '12sp'
                        size_hint_y: None
                        height: '24dp'
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.width, None

                Widget:
                    size_hint_y: None
                    height: '20dp'

        # ===== VISTA 2: CALCULADORA BÁSICA (ARITMÉTICA) =====
        BoxLayout:
            orientation: 'vertical'
            opacity: 1 if root.active_calc_mode == 'standard' else 0
            size_hint_y: 1 if root.active_calc_mode == 'standard' else None
            height: 0 if root.active_calc_mode != 'standard' else self.height
            disabled: root.active_calc_mode != 'standard'
            padding: [20, 10, 20, 16]
            spacing: 10

            # Pantalla Digital de la Calculadora
            DarkCard:
                padding: [20, 16]
                spacing: 6
                size_hint_y: None
                height: '110dp'

                Label:
                    text: root.calc_expression
                    font_size: '15sp'
                    color: app.text_secondary
                    halign: 'right'
                    valign: 'middle'
                    size_hint_y: None
                    height: '24dp'
                    text_size: self.size

                Label:
                    text: root.calc_display
                    font_size: '34sp'
                    bold: True
                    color: app.text_primary
                    halign: 'right'
                    valign: 'middle'
                    size_hint_y: None
                    height: '50dp'
                    text_size: self.size

            # Teclado Numérico (5 Filas x 4 Columnas)
            GridLayout:
                cols: 4
                spacing: 8
                size_hint_y: 1

                # Fila 1
                CalcOpButton:
                    text: "C"
                    on_release: root.on_key_press('C')
                CalcOpButton:
                    text: "\ue14a"
                    font_name: 'MaterialIcons'
                    font_size: '22sp'
                    on_release: root.on_key_press('DEL')
                CalcOpButton:
                    text: "%"
                    on_release: root.on_key_press('%')
                CalcActionButton:
                    text: "÷"
                    on_release: root.on_key_press('÷')

                # Fila 2
                CalcKeyButton:
                    text: "7"
                    on_release: root.on_key_press('7')
                CalcKeyButton:
                    text: "8"
                    on_release: root.on_key_press('8')
                CalcKeyButton:
                    text: "9"
                    on_release: root.on_key_press('9')
                CalcActionButton:
                    text: "×"
                    on_release: root.on_key_press('×')

                # Fila 3
                CalcKeyButton:
                    text: "4"
                    on_release: root.on_key_press('4')
                CalcKeyButton:
                    text: "5"
                    on_release: root.on_key_press('5')
                CalcKeyButton:
                    text: "6"
                    on_release: root.on_key_press('6')
                CalcActionButton:
                    text: "−"
                    on_release: root.on_key_press('−')

                # Fila 4
                CalcKeyButton:
                    text: "1"
                    on_release: root.on_key_press('1')
                CalcKeyButton:
                    text: "2"
                    on_release: root.on_key_press('2')
                CalcKeyButton:
                    text: "3"
                    on_release: root.on_key_press('3')
                CalcActionButton:
                    text: "+"
                    on_release: root.on_key_press('+')

                # Fila 5
                CalcOpButton:
                    text: "±"
                    on_release: root.on_key_press('NEG')
                CalcKeyButton:
                    text: "0"
                    on_release: root.on_key_press('0')
                CalcKeyButton:
                    text: "."
                    on_release: root.on_key_press('.')
                CalcEqualButton:
                    text: "="
                    on_release: root.on_key_press('=')

        NavBar:
