#:kivy 2.3.0

<DiaryScreen>:
    name: 'diary'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: app.bg_color
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [20, 16]
                spacing: 12

                # Botón Volver
                Button:
                    text: "[font=MaterialIcons][/font]  Volver"
                    markup: True
                    size_hint: (None, None)
                    size: ('90dp', '32dp')
                    background_normal: ''
                    background_color: (0, 0, 0, 0)
                    color: app.accent_blue
                    font_size: '15sp'
                    bold: True
                    on_release: app.go_back()

                # Encabezado con ícono lápiz (\ue3c9)
                Label:
                    text: "[font=MaterialIcons][/font]  [b]Mi diario[/b]"
                    markup: True
                    font_size: '24sp'
                    color: app.text_primary
                    halign: 'left'
                    valign: 'middle'
                    size_hint_y: None
                    height: '32dp'
                    text_size: self.size

                Label:
                    text: root.today_diary_title
                    font_size: '13sp'
                    color: app.text_secondary
                    halign: 'left'
                    valign: 'top'
                    size_hint_y: None
                    height: '20dp'
                    text_size: self.size

                # Selector de Pestañas (Segmented Chips Redondeados)
                BoxLayout:
                    size_hint_y: None
                    height: '42dp'
                    spacing: 10

                    Button:
                        text: "Nueva entrada"
                        font_size: '13sp'
                        bold: True
                        background_normal: ''
                        background_down: ''
                        background_color: (0, 0, 0, 0)
                        color: app.primary_text if root.active_tab == 0 else app.text_secondary
                        canvas.before:
                            Color:
                                rgba: app.primary_color if root.active_tab == 0 else app.card_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12)]
                            Color:
                                rgba: app.card_border
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(12)]
                                width: dp(1)
                        on_release: root.set_tab(0)

                    Button:
                        text: root.history_tab_title
                        font_size: '13sp'
                        bold: True
                        background_normal: ''
                        background_down: ''
                        background_color: (0, 0, 0, 0)
                        color: app.primary_text if root.active_tab == 1 else app.text_secondary
                        canvas.before:
                            Color:
                                rgba: app.primary_color if root.active_tab == 1 else app.card_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12)]
                            Color:
                                rgba: app.card_border
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(12)]
                                width: dp(1)
                        on_release: root.set_tab(1)

                # Contenedor dinámico de vista (Formulario o Historial)
                BoxLayout:
                    id: diary_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 10

        NavBar:
